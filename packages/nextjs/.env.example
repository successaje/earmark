# Copy to .env.local (git-ignored). Everything is optional for browsing the shared testnet deployment.

# --- Server-side only: never prefix these with NEXT_PUBLIC_ ---
# Hedera account that pays for HCS messages (charters, receipts) and runs `yarn earmark:setup` / `yarn earmark:demo`.
# Use an ECDSA account from https://portal.hedera.com
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=
# testnet | mainnet
HEDERA_NETWORK=testnet

# --- Public ---
# HCS topic Earmark anchors to. `yarn earmark:setup` creates one and writes it here; defaults to the shared testnet topic.
NEXT_PUBLIC_EARMARK_TOPIC_ID=
NEXT_PUBLIC_HEDERA_TESTNET_RPC_URL=
NEXT_PUBLIC_HEDERA_MAINNET_RPC_URL=
NEXT_PUBLIC_HEDERA_TESTNET_MIRROR_URL=
NEXT_PUBLIC_HEDERA_MAINNET_MIRROR_URL=
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=
